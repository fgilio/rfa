{
    "private": true,
    "scripts": {
        "build": "npm run css:build",
        "css:build": "tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --minify",
        "css:watch": "tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --watch",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.4",
        "happy-dom": "^21.0.4",
        "playwright": "^1.64.1",
        "tailwindcss": "^4.3.4",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=24"
    }
}
