    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.0",
        "happy-dom": "^20.9.0",
        "playwright": "^1.59.1",
        "tailwindcss": "^4.3.0",
        "vitest": "^4.1.5"
    }
}
