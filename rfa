#!/bin/bash
set -e

# Parse args: optional path positional, optional --context flag (any order)
MODE=""
RFA_INPUT_PATH=""
for arg in "$@"; do
    case "$arg" in
        --context) MODE="context" ;;
        -h|--help)
            echo "Usage: rfa [--context] [path]"
            echo "Open a Git repository or a single file in RFA."
            exit 0
            ;;
        -*)
            echo "Error: unknown option: $arg" >&2
            exit 1
            ;;
        *)
            if [ -n "$RFA_INPUT_PATH" ]; then
                echo "Error: expected one path, received more than one." >&2
                exit 1
            fi

            RFA_INPUT_PATH="$arg"
            ;;
    esac
done
RFA_INPUT_PATH="${RFA_INPUT_PATH:-$(pwd)}"

# Resolve directories to their Git root. Files stay files so the app can focus
# them and choose a managed workspace when they do not belong to a repository.
if [ -d "$RFA_INPUT_PATH" ]; then
    git -C "$RFA_INPUT_PATH" rev-parse --show-toplevel >/dev/null 2>&1 || {
        echo "Error: not a git repository: $RFA_INPUT_PATH" >&2
        exit 1
    }

    RFA_OPEN_PATH="$(git -C "$RFA_INPUT_PATH" rev-parse --show-toplevel)"
elif [ -f "$RFA_INPUT_PATH" ]; then
    RFA_OPEN_PATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$RFA_INPUT_PATH")"
else
    echo "Error: path does not exist or is not a regular file or directory: $RFA_INPUT_PATH" >&2
    exit 1
fi

# Write inbox file (cold-start safety: deep links can be lost if app isn't running yet)
# Uses unique filenames to avoid races between concurrent invocations.
# Two-line format when --context: <path>\n<mode>. The inbox parser splits
# then trims each line independently, so the trailing newline doesn't drop
# the mode line.
if [ "$(uname)" = "Darwin" ]; then
    APP_DATA_BASE="$HOME/Library/Application Support"
else
    APP_DATA_BASE="$HOME/.local/share"
fi
APP_DATA_DIR="$APP_DATA_BASE/com.fgilio.rfa"
INBOX_DIR="$APP_DATA_DIR/inbox"

# Recover a stale non-directory node by moving it aside, then (re)create the
# directory. Only ever called for the two nodes rfa owns: its app-data
# directory and that directory's inbox child. Concurrent invocations race
# here, so every step tolerates another process having already done it; the
# directory existing at the end is the only success condition.
ensure_rfa_dir() {
    local path="$1"

    if [ -d "$path" ]; then
        return 0
    fi

    if [ -e "$path" ] || [ -L "$path" ]; then
        mv "$path" "$path.$(date +%s)-$$.bak" 2>/dev/null || true
    fi

    mkdir -p "$path" 2>/dev/null || true

    [ -d "$path" ]
}

# Everything above the app-data directory ($HOME, Library, Application Support,
# .local/share) belongs to the user, not to rfa. Create it if it is missing,
# but never move a node aside to make room: report the blockage and leave the
# user's filesystem exactly as it was.
mkdir -p "$APP_DATA_BASE" 2>/dev/null || true
if [ ! -d "$APP_DATA_BASE" ]; then
    echo "Error: $APP_DATA_BASE is not a directory. rfa only repairs the paths it owns, so nothing was changed. Move or remove that node and retry." >&2
    exit 1
fi

for dir in "$APP_DATA_DIR" "$INBOX_DIR"; do
    ensure_rfa_dir "$dir" || {
        echo "Error: could not prepare $dir." >&2
        exit 1
    }
done

REQUEST_ID="$(date +%s%N)-$$"
INBOX_FILE="$INBOX_DIR/$REQUEST_ID.path"
INBOX_TMP="$INBOX_FILE.tmp"
if [ -n "$MODE" ]; then
    printf '%s\n%s\n' "$RFA_OPEN_PATH" "$MODE" > "$INBOX_TMP"
else
    echo "$RFA_OPEN_PATH" > "$INBOX_TMP"
fi
mv "$INBOX_TMP" "$INBOX_FILE"

# URL-encode the path
ENCODED_PATH=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$RFA_OPEN_PATH")

# Open via deep link (launches app if not running, or sends to running instance).
# The id is the inbox filename stem, so the two transports announce the same
# request: whichever reaches the app first claims it and the other stands down.
DEEP_LINK="rfa://open?path=$ENCODED_PATH&id=$REQUEST_ID"
if [ -n "$MODE" ]; then
    DEEP_LINK="$DEEP_LINK&mode=$MODE"
fi
open "$DEEP_LINK"
