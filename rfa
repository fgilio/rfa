#!/bin/bash
set -e

# Parse args: optional path positional, optional --context flag (any order)
MODE=""
RFA_REPO_PATH=""
for arg in "$@"; do
    case "$arg" in
        --context) MODE="context" ;;
        *) RFA_REPO_PATH="$arg" ;;
    esac
done
RFA_REPO_PATH="${RFA_REPO_PATH:-$(pwd)}"

# Validate git repo
git -C "$RFA_REPO_PATH" rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "Error: not a git repository" >&2
    exit 1
}

# Resolve to repo root
RFA_REPO_PATH="$(git -C "$RFA_REPO_PATH" rev-parse --show-toplevel)"

# Write inbox file (cold-start safety: deep links can be lost if app isn't running yet)
# Uses unique filenames to avoid races between concurrent invocations.
# Two-line format when --context: <repo-path>\n<mode>. The inbox parser splits
# then trims each line independently, so the trailing newline doesn't drop
# the mode line.
if [ "$(uname)" = "Darwin" ]; then
    APP_DATA_BASE="$HOME/Library/Application Support"
else
    APP_DATA_BASE="$HOME/.local/share"
fi
APP_DATA_DIR="$APP_DATA_BASE/com.fgilio.rfa"
INBOX_DIR="$APP_DATA_DIR/inbox"

# Recover a stale non-directory node by moving it aside, then (re)create the
# directory. Only ever called for the two nodes rfa owns: its app-data
# directory and that directory's inbox child. Concurrent invocations race
# here, so every step tolerates another process having already done it; the
# directory existing at the end is the only success condition.
ensure_rfa_dir() {
    local path="$1"

    if [ -d "$path" ]; then
        return 0
    fi

    if [ -e "$path" ] || [ -L "$path" ]; then
        mv "$path" "$path.$(date +%s)-$$.bak" 2>/dev/null || true
    fi

    mkdir -p "$path" 2>/dev/null || true

    [ -d "$path" ]
}

# Everything above the app-data directory ($HOME, Library, Application Support,
# .local/share) belongs to the user, not to rfa. Create it if it is missing,
# but never move a node aside to make room: report the blockage and leave the
# user's filesystem exactly as it was.
mkdir -p "$APP_DATA_BASE" 2>/dev/null || true
if [ ! -d "$APP_DATA_BASE" ]; then
    echo "Error: $APP_DATA_BASE is not a directory. rfa only repairs the paths it owns, so nothing was changed. Move or remove that node and retry." >&2
    exit 1
fi

for dir in "$APP_DATA_DIR" "$INBOX_DIR"; do
    ensure_rfa_dir "$dir" || {
        echo "Error: could not prepare $dir." >&2
        exit 1
    }
done

INBOX_FILE="$INBOX_DIR/$(date +%s%N)-$$.path"
INBOX_TMP="$INBOX_FILE.tmp"
if [ -n "$MODE" ]; then
    printf '%s\n%s\n' "$RFA_REPO_PATH" "$MODE" > "$INBOX_TMP"
else
    echo "$RFA_REPO_PATH" > "$INBOX_TMP"
fi
mv "$INBOX_TMP" "$INBOX_FILE"

# URL-encode the path
ENCODED_PATH=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$RFA_REPO_PATH")

# Open via deep link (launches app if not running, or sends to running instance)
DEEP_LINK="rfa://open?path=$ENCODED_PATH"
if [ -n "$MODE" ]; then
    DEEP_LINK="$DEEP_LINK&mode=$MODE"
fi
open "$DEEP_LINK"
